#!/bin/bash
# Liga/desliga as cores do pywal (geradas a partir do papel de parede).
#
#   tema               alterna: pywal <-> padrão
#   tema on | off      liga / desliga
#   tema imagem.jpg    gera cores novas a partir da imagem (troca o papel de parede) e liga
#   tema status        mostra qual está ativo
#
# Atalho no dwm: Super+Shift+T. O estado vale também para o próximo login.
set -eu

cache="$HOME/.cache/wal"
flag="$HOME/.cache/tema-pywal"          # existe = pywal ligado
padrao="$HOME/.source/config/Xresources"
extra="$cache/colors-suckless.Xresources"
cinza="#202329"                         # fundo da tela no tema padrão (ver config/Xresources)
cinza_img="$HOME/.cache/tema-fundo-${cinza#\#}.png"   # o nome muda com a cor: trocar a cor gera outra imagem

msg() { echo "$1"; notify-send -h string:x-canonical-private-synchronous:tema "Tema" "$1" 2>/dev/null || true; }

# papel de parede: $1 = imagem, ou "cinza" para a cor sólida do tema padrão
fundo() {
    command -v feh >/dev/null || return 0
    if [ "$1" = cinza ]; then
        [ -f "$cinza_img" ] || magick -size 16x16 "xc:$cinza" "$cinza_img" 2>/dev/null ||
            convert -size 16x16 "xc:$cinza" "$cinza_img" 2>/dev/null || return 0
        feh --bg-tile "$cinza_img"
    elif [ -f "$1" ]; then
        feh --bg-fill "$1"
    fi
}

recarregar() {
    xdotool key --clearmodifiers super+F5 2>/dev/null || true   # dwm (solta o Shift do atalho)
    pkill -USR1 -x st 2>/dev/null || true      # st (todos os terminais abertos)
}

# O pywal só gera *.colorN; dwm, dmenu e slock usam nomes próprios.
gerar_extra() {
    # define $background, $foreground, $color0..$color15. O colors.sh do pywal16
    # usa variáveis que podem não existir (ex.: $FZF_DEFAULT_OPTS), então lê sem o "set -u"
    set +u
    . "$cache/colors.sh"
    set -u
    cat > "$extra" <<XRES
dwm.normbgcolor:     $background
dwm.normfgcolor:     $foreground
dwm.normbordercolor: $color8
dwm.selbgcolor:      $color4
dwm.selfgcolor:      $foreground
dwm.selbordercolor:  $foreground
dmenu.background:    $background
dmenu.foreground:    $foreground
dmenu.selbackground: $color4
dmenu.selforeground: $foreground
slock.color0:        $background
slock.color4:        $color4
slock.color1:        $color1
slock.color3:        $color3
slock.foreground:    $foreground
XRES
}

ligar() {
    if [ ! -f "$cache/colors.sh" ]; then
        msg "Nenhuma cor do pywal ainda. Use: tema imagem.jpg"
        exit 1
    fi
    gerar_extra
    # começa do tema padrão e põe o pywal por cima
    xrdb -load "$padrao"
    xrdb -merge "$cache/colors.Xresources"
    xrdb -merge "$extra"
    touch "$flag"
    fundo "${wallpaper:-}"
    recarregar
    msg "Tema: pywal ($(basename "${wallpaper:-?}"))"
}

desligar() {
    # -load substitui tudo: o pywal grava cada cor em dois formatos (*.color0 e
    # *color0) e com -merge as cópias dele continuavam valendo
    xrdb -load "$padrao"
    rm -f "$flag"
    fundo cinza
    recarregar
    msg "Tema: padrão"
}

case "${1:-toggle}" in
    toggle)  if [ -f "$flag" ]; then desligar; else ligar; fi ;;
    on)      ligar ;;
    off)     desligar ;;
    status)  [ -f "$flag" ] && echo "pywal" || echo "padrão" ;;
    -h|--help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//' ;;
    *)
        [ -f "$1" ] || { echo "Imagem não encontrada: $1 (veja: tema --help)"; exit 1; }
        command -v wal >/dev/null || { echo "pywal não instalado: sudo pacman -S python-pywal"; exit 1; }
        img=$(readlink -f "$1")
        # -n: o pywal só gera as cores; o papel de parede fica com o feh, que
        # também grava ~/.fehbg (o .xinitrc usa para restaurar no login)
        wal -q -n -i "$img"
        command -v feh >/dev/null ||
            msg "Sem feh: as cores mudam, mas o papel de parede não. Instale: sudo pacman -S feh"
        ligar
        ;;
esac
